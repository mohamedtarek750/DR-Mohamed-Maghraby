# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://dr-mohamed-maghraby.vercel.app

# OPTIONAL. Where booking requests are forwarded (e.g. a Zapier/Make/n8n webhook,
# or any endpoint that accepts a JSON POST). Leave unset and the booking form
# falls back to opening a pre-filled email to the clinic instead.
BOOKING_WEBHOOK_URL=
